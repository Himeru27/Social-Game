; Engine configuration file - Godot 4.3+
config_version=5

[application]

config/name="Vibe n' Chat"
config/version="0.1.0"
run/main_scene="res://scenes/intro/intro.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameSettings="*res://autoload/game_settings.gd"
PlayerProfile="*res://autoload/player_profile.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
Net="*res://autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.105, 0.125, 0.22, 1)
